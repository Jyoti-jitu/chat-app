{
  "openapi": "3.1.0",
  "info": {
    "title": "FluxChat Conversation & Group Service",
    "description": "\n# 💬 FluxChat Conversation & Group Service\n\nThe **Chat Service** manages direct 1:1 messaging channels, multi-participant group chats, member rosters, and inbox feeds.\n\n## Capabilities\n- **Direct 1:1 Chats**: Deterministic recipient deduplication ensuring unique channels per pair.\n- **Group Conversations**: Dynamic group naming, member additions, removals, and admin permissions.\n- **Inbox Feed Sorting**: Chronological feed ordering via Atlas compound index `{ members: 1, updated_at: -1 }`.\n",
    "contact": {
      "name": "FluxChat Engineering Team",
      "url": "https://github.com/Jyoti-jitu/chat-app"
    },
    "license": {
      "name": "MIT License"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns the operational status of the Chat Service and MongoDB Atlas connection.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns the operational status of the Chat Service and MongoDB Atlas connection.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/direct": {
      "post": {
        "tags": [
          "Conversations"
        ],
        "summary": "Create or Retrieve Direct Chat",
        "description": "Initiates a 1:1 direct chat or retrieves the existing conversation thread if one already exists.",
