  },
  "components": {
    "schemas": {
      "ActionSuccessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ActionSuccessResponse",
        "description": "Generic status response for conversation mutations."
      },
      "AddMembersPayload": {
        "properties": {
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Member Ids",
            "description": "List of user IDs to add"
          }
        },
        "type": "object",
        "required": [
          "member_ids"
        ],
        "title": "AddMembersPayload",
        "description": "Payload for adding participants to an existing group."
      },
      "ConversationListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "ConversationListResponse",
        "description": "List of conversations belonging to the authenticated user."
      },
      "ConversationMemberInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar"
          },
          "is_online": {
            "type": "boolean",
            "title": "Is Online",
            "default": false
          },
          "last_seen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "username"
        ],
        "title": "ConversationMemberInfo",
        "description": "Sanitized public profile of a conversation participant."
      },
      "ConversationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "'direct' or 'group'"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Group title or counterpart name for direct chats"
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar",
            "description": "Group avatar or counterpart avatar for direct chats"
          },
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Member Ids"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/ConversationMemberInfo"
            },
            "type": "array",
            "title": "Members"
          },
          "admins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Admins"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "last_message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastMessageInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "unread_count": {
            "type": "integer",
            "title": "Unread Count",
            "default": 0
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "title": "ConversationResponse",
        "description": "Detailed conversation representation for API clients."
      },
      "CreateDirectConversation": {
        "properties": {
          "recipient_id": {
            "type": "string",
            "title": "Recipient Id",
            "description": "Target user ID to chat with"
          }
        },
        "type": "object",
        "required": [
          "recipient_id"
        ],
        "title": "CreateDirectConversation",
        "description": "Payload for initiating or opening a 1:1 direct conversation."
      },
      "CreateGroupConversation": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "Group conversation title"
          },
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Member Ids",
            "description": "List of participant user IDs"
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar",
            "description": "Optional custom group avatar image URL"
          }
        },
        "type": "object",
        "required": [
          "name",
          "member_ids"
        ],
        "title": "CreateGroupConversation",
        "description": "Payload for creating a new group conversation."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "title": "Database",
            "example": "connected"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "example": "FluxChat Conversation Service"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0",
            "example": "1.0.0"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "example": "development"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "service",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Service health response contract."
      },
      "LastMessageInfo": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "sender_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender Id"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "type": "object",
        "title": "LastMessageInfo",
        "description": "Preview of the most recent message in the thread."
      },
      "UpdateGroupConversation": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar"
          }
        },
        "type": "object",
        "title": "UpdateGroupConversation",
        "description": "Payload for updating group metadata."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Conversations",
      "description": "1:1 direct conversations, group channels, and member management."
    },
    {
      "name": "Health",
      "description": "Chat Service health check and Atlas database verification."
    }
  ]
}