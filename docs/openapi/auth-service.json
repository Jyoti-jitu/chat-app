  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service operational status",
            "default": "ok"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database",
            "description": "Database connection status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Name of the running microservice"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Microservice API version",
            "default": "1.0.0"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Running environment (development/production)"
          }
        },
        "type": "object",
        "required": [
          "service",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "LoginOtpRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "title": "Session Id",
            "description": "2Factor session ID"
          },
          "otp": {
            "type": "string",
            "maxLength": 8,
            "minLength": 4,
            "title": "Otp",
            "description": "OTP code received via SMS"
          },
          "phone": {
            "type": "string",
            "minLength": 10,
            "title": "Phone",
            "description": "Mobile number"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "otp",
          "phone"
        ],
        "title": "LoginOtpRequest",
        "description": "Payload for mobile OTP login."
      },
      "LogoutResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Successfully logged out"
          }
        },
        "type": "object",
        "title": "LogoutResponse",
        "description": "Logout acknowledgment response."
      },
      "RootResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Welcome message"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service name"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database",
            "description": "Database connection status"
          },
          "docs_url": {
            "type": "string",
            "title": "Docs Url",
            "description": "Interactive OpenAPI documentation URL"
          },
          "health_url": {
            "type": "string",
            "title": "Health Url",
            "description": "Health check endpoint URL"
          }
        },
        "type": "object",
        "required": [
          "message",
          "service",
          "docs_url",
          "health_url"
        ],
        "title": "RootResponse"
      },
      "SendOtpRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 10,
            "title": "Phone",
            "description": "Recipient Indian mobile number"
          },
          "purpose": {
            "type": "string",
            "pattern": "^(register|login)$",
            "title": "Purpose",
            "description": "Purpose: register or login",
            "default": "register"
          },
          "channel": {
            "type": "string",
            "pattern": "^(sms|voice)$",
            "title": "Channel",
            "description": "Delivery channel: voice call or sms",
            "default": "voice"
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "SendOtpRequest",
        "description": "Payload for requesting a 2Factor Voice Call or SMS OTP."
      },
      "SendOtpResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "resend_cooldown": {
            "type": "integer",
            "title": "Resend Cooldown"
          }
        },
        "type": "object",
        "required": [
          "message",
          "session_id",
          "phone",
          "expires_in",
          "resend_cooldown"
        ],
        "title": "SendOtpResponse",
        "description": "Response returned upon 2Factor OTP dispatch."
      },
      "TokenRefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token",
            "description": "Valid refresh token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "TokenRefreshRequest",
        "description": "Payload for refreshing an expired access token."
      },
      "TokenRefreshResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Access token expiration in seconds",
            "default": 900
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenRefreshResponse",
        "description": "Refreshed token pair payload."
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
