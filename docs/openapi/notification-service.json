{
  "openapi": "3.1.0",
  "info": {
    "title": "FluxChat Notification & Alerts Service",
    "description": "\n# 🔔 FluxChat Notification & Alerts Service\n\nThe **Notification Service** provides persistent inbox storage, real-time alert dispatch, unread counters, and category-filtered notifications.\n\n## Capabilities\n- **Persistent Inbox**: Alerts for new messages, friendship requests, and group invites.\n- **Unread Counters**: Real-time aggregation of unread notifications for navigation badges.\n- **Bulk Operations**: Mark-as-read, read-all, and dismiss-all lifecycles.\n- **Real-Time Integration**: Emits `notification.new` events via Redis Pub/Sub directly to client sockets.\n",
    "contact": {
      "name": "FluxChat Engineering Team",
      "url": "https://github.com/Jyoti-jitu/chat-app"
    },
    "license": {
      "name": "MIT License"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns the operational status of the Notification Service and MongoDB Atlas connection.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
