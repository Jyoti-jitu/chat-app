{
  "openapi": "3.1.0",
  "info": {
    "title": "FluxChat WebSocket & Real-Time Event Service",
    "description": "\n# ⚡ FluxChat WebSocket & Real-Time Event Service\n\nThe **WebSocket Service** handles authenticated persistent bidirectional client connections, heartbeat pings/pongs, presence synchronization, and ephemeral typing indicators.\n\n## Framing Protocols & Events\n- **`connection.ack`**: Emitted upon successful handshake with current user ID and active online roster.\n- **`chat.message`**: Real-time dispatch of inbound messages to recipient sockets.\n- **`presence.status`**: Online, away, and offline transition broadcasts backed by Redis TTL.\n- **`typing.start` / `typing.stop`**: Ephemeral typing indicators with 5-second auto-expiry.\n",
    "contact": {
      "name": "FluxChat Engineering Team",
      "url": "https://github.com/Jyoti-jitu/chat-app"
    },
    "license": {
      "name": "MIT License"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns operational status of the WebSocket Service, database ping, and active connection count.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/broadcast": {
      "post": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Broadcast Event to Connected Users",
        "description": "Internal REST endpoint for microservices to broadcast real-time events.",
        "operationId": "broadcast_event_events_broadcast_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BroadcastEventPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/presence/online": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "List Currently Online Users",
        "description": "Returns list and counts of currently active online users.",
        "operationId": "get_online_users_presence_online_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnlinePresenceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/presence/{user_id}": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Check User Online Status",
        "description": "Returns whether a specific user is currently connected via WebSocket.",
        "operationId": "check_user_presence_presence__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPresenceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Returns operational status of the WebSocket Service, database ping, and active connection count.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/broadcast": {
      "post": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Broadcast Event to Connected Users",
        "description": "Internal REST endpoint for microservices to broadcast real-time events.",
        "operationId": "broadcast_event_api_v1_events_broadcast_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BroadcastEventPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presence/online": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "List Currently Online Users",
        "description": "Returns list and counts of currently active online users.",
        "operationId": "get_online_users_api_v1_presence_online_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnlinePresenceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presence/{user_id}": {
      "get": {
        "tags": [
          "WebSockets"
        ],
        "summary": "Check User Online Status",
        "description": "Returns whether a specific user is currently connected via WebSocket.",
        "operationId": "check_user_presence_api_v1_presence__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPresenceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BroadcastEventPayload": {
        "properties": {
          "event": {
            "type": "string",
            "title": "Event",
            "description": "Event identifier"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "Event payload dictionary"
          },
          "recipient_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient Ids",
            "description": "Target user IDs to receive this event. If None or empty, broadcasts to all."
          },
          "exclude_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclude User Id",
            "description": "User ID to omit from receiving this broadcast (usually the actor)."
          }
        },
        "type": "object",
        "required": [
          "event"
        ],
        "title": "BroadcastEventPayload",
        "description": "Payload for internal microservice REST bridge to broadcast events."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "active_users": {
            "type": "integer",
            "title": "Active Users",
            "default": 0
          },
          "active_connections": {
            "type": "integer",
            "title": "Active Connections",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Health check payload structure."
      },
      "OnlinePresenceResponse": {
        "properties": {
          "online_users": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Online Users"
          },
          "total_online": {
            "type": "integer",
            "title": "Total Online"
          },
          "total_connections": {
            "type": "integer",
            "title": "Total Connections"
          }
        },
        "type": "object",
        "required": [
          "online_users",
          "total_online",
          "total_connections"
        ],
        "title": "OnlinePresenceResponse",
        "description": "Summary of currently connected users and sockets."
      },
      "UserPresenceResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "is_online": {
            "type": "boolean",
            "title": "Is Online"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "is_online"
        ],
        "title": "UserPresenceResponse",
        "description": "Presence status for an individual user."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "WebSockets",
      "description": "Persistent bidirectional WebSocket framing and connection management."
    },
    {
      "name": "Presence",
      "description": "User online/offline status query and manual presence updates."
    },
    {
      "name": "Events",
      "description": "Internal Redis pub/sub event ingest and fanout."
    },
    {
      "name": "Health",
      "description": "WebSocket Service health check and broker connectivity."
    }
  ]
}