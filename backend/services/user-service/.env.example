# FluxChat User Service Configuration
APP_NAME="FluxChat User Service"
APP_ENV=development
DEBUG=True
PORT=8002
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Database Configuration
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Chat
MONGODB_DATABASE=fluxchat_db
REDIS_URL=redis://localhost:6379/0

# JWT Secret (Must match Auth Service)
JWT_SECRET=fluxchat-production-jwt-secret-key-32-chars-long-secure
JWT_ALGORITHM=HS256

LOG_LEVEL=INFO
