# ==============================================================================
# FluxChat Auth Service — Environment Configuration
# ==============================================================================

# Application Details
APP_NAME="FluxChat Auth Service"
APP_ENV=development
DEBUG=True
PORT=8001
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database Configuration (Phase 2 - MongoDB Foundation with Atlas or Local)
# For Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Chat
# For Local: mongodb://localhost:27017
MONGODB_URL=mongodb+srv://<username>:<password>@chat.njrcbvy.mongodb.net/?appName=Chat
MONGODB_DATABASE=fluxchat_db


# JWT Authentication Configuration (Phase 3)
JWT_SECRET=replace-with-a-very-secure-random-32-character-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 2Factor SMS OTP Configuration (India SMS Gateway)
# Obtain your API key from https://2factor.in
TWO_FACTOR_API_KEY=your_2factor_api_key_here
TWO_FACTOR_BASE_URL=https://2factor.in/API/V1
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Not active in Phase 3)
# ------------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

