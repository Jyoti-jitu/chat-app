# ==============================================================================
# FluxChat Auth Service — Environment Configuration
# ==============================================================================

# Application Details
APP_NAME="FluxChat Auth Service"
APP_ENV=development
DEBUG=True
PORT=8001
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database Configuration (Phase 2 - MongoDB Foundation)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=fluxchat_db

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Not active in Phase 2)
# ------------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=super-secret-key-placeholder-32-chars-min
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

