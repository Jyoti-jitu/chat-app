# ==============================================================================
# FluxChat WebSocket Service Configuration
# ==============================================================================

APP_NAME="FluxChat WebSocket Service"
APP_ENV="development"
DEBUG=true
PORT=8005
HOST="0.0.0.0"

# MongoDB Atlas Database Configuration
MONGODB_URL="mongodb+srv://<username>:<password>@chat.njrcbvy.mongodb.net/?appName=Chat"
MONGODB_DATABASE="fluxchat_db"

# JWT Authentication
JWT_SECRET="fluxchat-production-jwt-secret-key-32-chars-long-secure"
JWT_ALGORITHM="HS256"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL="INFO"
