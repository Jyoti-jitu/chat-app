# ==============================================================================
# FluxChat Notification Service Configuration
# ==============================================================================

APP_NAME="FluxChat Notification Service"
APP_ENV="development"
DEBUG=true
PORT=8006
HOST="0.0.0.0"

# MongoDB Atlas Database Configuration
MONGODB_URL="mongodb+srv://<username>:<password>@chat.njrcbvy.mongodb.net/?appName=Chat"
MONGODB_DATABASE="fluxchat_db"

# JWT Authentication Configuration
JWT_SECRET="fluxchat-production-jwt-secret-key-32-chars-long-secure"
JWT_ALGORITHM="HS256"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL="INFO"
