# ==============================================================================
# FluxChat Backend — Render Production Environment Variables
# ==============================================================================

# MongoDB Connection String (from MongoDB Atlas M0 free cluster)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/fluxchat_db?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://admin:securepassword@cluster0.abcde.mongodb.net/fluxchat_db?retryWrites=true&w=majority
MONGODB_DATABASE=fluxchat_db

# 2Factor SMS & Voice OTP API Key (from https://2factor.in)
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# JWT Signing Secret (Random 32+ characters string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Optional External Redis (e.g. Upstash Redis free tier or Render Redis)
# If omitted, an embedded Redis instance inside the container is used automatically
REDIS_URL=redis://127.0.0.1:6379/0

# Allowed CORS Origins (Comma-separated)
# Automatically matches https://*.vercel.app by regex, but you can list specific custom domains here:
CORS_ORIGINS=http://localhost:3000,https://fluxchat.vercel.app

# Environment & Rate Limits
ENVIRONMENT=production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=1200
RATE_LIMIT_AUTH=25
