# ==============================================================================
# FluxChat Enterprise - Docker Environment Configuration Template
# Copy this file to .env before starting the cluster with `docker compose up`
# ==============================================================================

# MongoDB Atlas Persistent Database Connection
# Replace with your production MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=FluxChat
MONGODB_DATABASE=fluxchat_db

# Security & Authentication (HS256 minimum 32 characters)
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-min-32-chars

# 2Factor SMS Gateway (Optional: leave blank for dev sandbox OTP 123456)
TWO_FACTOR_API_KEY=

# Internal Redis Cache & Event Bus (default containerized redis)
REDIS_URL=redis://redis:6379/0

# Public Frontend Endpoint Ingress
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
