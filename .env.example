# ==============================================================================
# FluxChat Enterprise — Master Environment Configuration Template
# Follows the Twelve-Factor App methodology (III. Config stored strictly in environment)
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
APP_NAME=FluxChat
APP_ENV=development                    # development | staging | production
DEBUG=true                             # Set to false in production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas Persistent Source of Truth)
# ------------------------------------------------------------------------------
# Connection string to your MongoDB Atlas replica set (or local MongoDB for testing)
MONGODB_URL=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=FluxChat
MONGODB_DATABASE=fluxchat_db

# ------------------------------------------------------------------------------
# 3. Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
# Redis instance used for pub/sub, presence tracking, rate limiting, and ephemeral state
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Security & Cryptography (JWT & Password Hashing)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret. MUST be changed in production!
JWT_SECRET=fluxchat-dev-secret-key-32-chars-minimum-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 5. External SMS Gateway (2Factor.in)
# ------------------------------------------------------------------------------
# Leave empty to use development sandbox OTP (123456)
TWO_FACTOR_API_KEY=
TWO_FACTOR_BASE_URL=https://2factor.in/API/V1
TWO_FACTOR_OTP_TEMPLATE=
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 6. Microservice Ingress & Port Mapping
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
CHAT_SERVICE_PORT=8003
MESSAGE_SERVICE_PORT=8004
WS_SERVICE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 7. Internal Service Endpoints (Used by API Gateway & Inter-Service RPC)
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://127.0.0.1:8001
USER_SERVICE_URL=http://127.0.0.1:8002
CHAT_SERVICE_URL=http://127.0.0.1:8003
MESSAGE_SERVICE_URL=http://127.0.0.1:8004
WS_SERVICE_URL=ws://127.0.0.1:8005
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8006

# ------------------------------------------------------------------------------
# 8. CORS & Gateway Ingress
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 9. Next.js Frontend Ingress URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
